// Cloudflare Workers config. The site is static, so the Worker only serves the
// built files in dist/ (Cloudflare's static assets, no Worker script).
// Cloudflare builds it on every push: `npm run build`, then `npx wrangler deploy`.
{
  "name": "poison-atlas",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
  },
  // Branches and pull requests are deployed as Previews (`npx wrangler
  // preview`), each with its own URL. The block can stay empty.
  "previews": {},
}
