{
  "name": "poison-atlas",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "images": "tsx scripts/sync-images.ts",
    "boundaries": "tsx scripts/build-boundaries.ts",
    "tdwg": "tsx scripts/build-tdwg.ts",
    "new": "tsx scripts/new-species.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "ranges": "tsx scripts/ranges.ts",
    "check": "npm run validate && npm run lint:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "mapshaper": "^0.7.67",
    "pbf": "^5.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true,
    "fsevents": true,
    "msgpackr-extract": false
  }
}
